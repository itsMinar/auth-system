                "github",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "{{githubAuthCode}}"
                },
                {
                  "key": "state",
                  "value": "{{state}}"
                }
              ]
            },
            "description": "OAuth callback from GitHub. Exchanges authorization code for tokens and redirects to CLIENT_URL."
