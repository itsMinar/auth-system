              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "sessions",
                "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
              ]
            },
            "description": "Revoke a specific session by its ID."
          },
          "response": [
            {
              "name": "Success",
              "status": "No Content",
              "code": 204,
              "header": []
            },
            {
              "name": "Not Found",
